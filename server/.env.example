# Server Configuration
PORT=4001
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/innostay

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here

# Email Configuration (for email OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=InnoStay <no-reply@innostay.local>

# SMS Configuration (for mobile OTP)
# Fast2SMS (https://www.fast2sms.com/)
FAST2SMS_API_KEY=your-fast2sms-api-key-here

# Textlocal (https://www.textlocal.in/) - More reliable alternative
TEXTLOCAL_API_KEY=your-textlocal-api-key-here

# Alternative: Twilio (uncomment and configure if using Twilio)
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
